# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Web assets text
*.html text
*.css text
*.js text
*.json text
*.webmanifest text
*.svg text
*.md text
*.xml text
*.txt text
